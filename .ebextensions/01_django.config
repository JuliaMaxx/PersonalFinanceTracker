option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: personal_finance_tracker.wsgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: personal_finance_tracker.settings

container_commands:
  01_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
  02_collectstatic:
    command: "python manage.py collectstatic --noinput"
    leader_only: true
